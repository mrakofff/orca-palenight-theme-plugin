{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#1B1F30",
    "--foreground": "#F5F7FF",
    "--editor-surface": "#292D3E",
    "--card": "#292D3E",
    "--card-foreground": "#A6ACCD",
    "--popover": "#2C3043",
    "--popover-foreground": "#A6ACCD",
    "--primary": "#7E57C2",
    "--primary-foreground": "#FFFFFF",
    "--secondary": "#333747",
    "--secondary-foreground": "#A6ACCD",
    "--muted": "#1B1E2B",
    "--muted-foreground": "#A3AAD2",
    "--accent": "#31364B",
    "--accent-foreground": "#EEFFFF",
    "--border": "#3A3F58",
    "--input": "#3A3F58",
    "--ring": "#8F9BDA",
    "--chart-1": "#82AAFF",
    "--chart-2": "#C3E88D",
    "--chart-3": "#FFCB6B",
    "--chart-4": "#F07178",
    "--chart-5": "#C792EA",
    "--sidebar": "#1B1E2B",
    "--sidebar-foreground": "#A6ACCD",
    "--sidebar-primary": "#7E57C2",
    "--sidebar-primary-foreground": "#FFFFFF",
    "--sidebar-accent": "#34394F",
    "--sidebar-accent-foreground": "#EEFFFF",
    "--sidebar-border": "#2B2F42",
    "--sidebar-ring": "#8F9BDA",
    "--worktree-sidebar-active": "#7E57C233",
    "--worktree-sidebar-active-border": "#7E57C266",
    "--host-badge": "#3A3F58",
    "--host-badge-foreground": "#A6ACCD",
    "--tab-bar": "#31364A",
    "--tab-active": "#292D3E",
    "--tab-active-foreground": "#EEFFFF",
    "--tab-active-indicator": "#7E57C2",
    "--tab-inactive": "#31364A",
    "--tab-inactive-foreground": "#9AA2D0",
    "--split-divider": "#262A39",
    "--split-divider-hover": "#7E57C2",
    "--chat-user-message": "#383C52",
    "--text-link": "#82AAFF",
    "--diff-added": "#C3E88D",
    "--diff-added-background": "#99B76D23",
    "--diff-added-emphasis": "#99B76D45",
    "--diff-added-gutter": "#9CCC6566",
    "--diff-removed": "#F07178",
    "--diff-removed-background": "#EF535033",
    "--diff-removed-emphasis": "#EF535059",
    "--diff-removed-gutter": "#EF535080",
    "--git-decoration-added": "#C3E88D",
    "--git-decoration-modified": "#E2C08D",
    "--git-decoration-deleted": "#F07178",
    "--git-decoration-renamed": "#82AAFF",
    "--git-decoration-untracked": "#A9C77D",
    "--git-decoration-copied": "#89DDFF",
    "--git-decoration-ignored": "#697098"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#7A82A6", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#C3E88D" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#89DDFF" } },
    { "scope": "string.regexp", "settings": { "foreground": "#89DDFF" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#F78C6C" } },
    { "scope": "constant", "settings": { "foreground": "#F78C6C" } },
    { "scope": "constant.language", "settings": { "foreground": "#F78C6C" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#C792EA" } },
    { "scope": "keyword.control", "settings": { "foreground": "#C792EA", "fontStyle": "italic" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#89DDFF" } },
    { "scope": "keyword.other.unit", "settings": { "foreground": "#F78C6C" } },
    { "scope": "punctuation", "settings": { "foreground": "#89DDFF" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#FFCB6B" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#82AAFF" } },
    { "scope": "support.function", "settings": { "foreground": "#82AAFF" } },
    { "scope": "variable", "settings": { "foreground": "#BABED8" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#F78C6C" } },
    { "scope": "support.variable", "settings": { "foreground": "#EEFFFF" } },
    { "scope": "support.type.property-name", "settings": { "foreground": "#C792EA" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#F07178" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#C792EA" } },
    { "scope": "meta.decorator", "settings": { "foreground": "#82AAFF" } },
    { "scope": "markup.heading", "settings": { "foreground": "#89DDFF", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#82AAFF" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#C3E88D" } },
    { "scope": "markup.quote", "settings": { "foreground": "#7A82A6", "fontStyle": "italic" } },
    { "scope": "invalid", "settings": { "foreground": "#FF5370" } }
  ]
}
